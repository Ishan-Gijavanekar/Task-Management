APP_NAME=user-service
APP_ENV=development
HTTP_PORT=8080
HTTP_ALLOWED_ORIGINS=http://localhost:5173
HTTP_BODY_LIMIT_MB=1
HTTP_TRUSTED_PROXIES=
GRPC_PORT=50051
GRPC_REFLECTION_ENABLED=true
MONGO_URI=mongodb://root:rootpassword@localhost:27017/?authSource=admin
MONGO_DATABASE=user_service
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACTIVE_KEY_ID=current
JWT_PREVIOUS_KEYS=
JWT_ISSUER=user-service
JWT_ACCESS_TOKEN_DURATION=15m
AUTH_REFRESH_TOKEN_DURATION=720h
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
